{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start local server",
      "type": "shell",
      "command": "python",
      "args": ["-m", "http.server", "8000", "--bind", "127.0.0.1"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "http-server",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP on",
          "endsPattern": "^$"
        }
      }
    }
  ]
}
